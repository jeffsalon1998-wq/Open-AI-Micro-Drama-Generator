MUAPI_KEY=your_api_key_here

# --- Model Selection & Cost Optimisation Options ---
# Set SKIP_SEEDANCE=True to skip the expensive Seedance video generation model and call Kling directly.
SKIP_SEEDANCE=False

# Model endpoints on MuAPI. Override these if you want to use cheaper alternative endpoints.
# For example, to save cost, set KLING_MODEL=kling-v2.1-standard-i2v
KLING_MODEL=kling-v2.1-master-i2v
SEEDANCE_MODEL=seedance-2-vip-image-to-video
PORTRAIT_MODEL=bytedance-seedream-v4.5
FRAME_MODEL=nano-banana-2-edit
LLM_MODEL=claude-sonnet-4-6

# --- Video provider selection ---
# auto  -> use a2e when A2E_API_KEY is set, otherwise MuAPI (Seedance/Kling)
# a2e   -> force a2e.ai image-to-video
# muapi -> force MuAPI Seedance 2 VIP / Kling Master
VIDEO_PROVIDER=auto
# Fall through to the other provider if the primary one fails mid-run
VIDEO_FALLBACK=true
# Vertical-first delivery for micro-drama (9:16). Use 16:9 for landscape cutdowns.
VIDEO_ASPECT_RATIO=9:16
# Seconds per generated clip. Retention mode renders longer continuous takes.
CLIP_SECONDS=5
RETENTION_CLIP_SECONDS=10

# --- a2e.ai (optional second video provider) ---
# Get a key at https://a2e.ai — leave blank to stay on MuAPI only.
A2E_API_KEY=
A2E_BASE_URL=https://api.a2e.ai
# a2e | a2e-v2 | a2e-v2-flash  (v2 = continuous 24fps clips up to 20s + native audio)
A2E_MODEL_VERSION=a2e-v2
# true -> reference-to-video (character identity lock from portraits, needs a2e-v2)
A2E_REFERENCE_MODE=false
# true -> native audio on a2e-v2 (no ThinkSound surcharge)
A2E_AUTO_AUDIO=true
A2E_TIMEOUT=900
A2E_POLL_INTERVAL=3

# --- Output normalisation (mixed providers / resolutions) ---
# Final video resolution. Keep 720x1280 for vertical micro-drama.
TARGET_RESOLUTION=720x1280
TARGET_FPS=24
